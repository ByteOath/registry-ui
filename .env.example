# Master admin credentials (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session encryption secret — generate with: openssl rand -hex 32
APP_SECRET=change-this-secret-must-be-32-chars!!

# SQLite database path (inside Docker volume)
DB_PATH=/data/registry-ui.db

# Automatic tag cleanup — set to false to disable the background sweep entirely.
# Per-registry policy ("keep last N tags") is configured in Admin → Registries.
RETENTION_AUTO=true
RETENTION_INTERVAL_HOURS=24
